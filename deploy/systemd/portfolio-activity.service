[Unit]
Description=Refresh the GitHub activity feed of bastiengaffet.fr
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=portfolio
Group=portfolio
ExecStart=/usr/bin/python3 /usr/local/bin/portfolio-activity
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/portfolio/shared
RestrictAddressFamilies=AF_INET AF_INET6
MemoryMax=128M
